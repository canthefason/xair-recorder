[Unit]
Description=X Air Recorder - auto-switch to venue AP when home network is unreachable
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=__INSTALL_DIR__/network/network-watchdog.sh __WIFI_DEVICE__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
